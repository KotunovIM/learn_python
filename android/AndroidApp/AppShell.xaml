<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AndroidApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:AndroidApp.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="CheckListApp">

    <!-- Простой заголовок, который точно работает -->
    <Shell.FlyoutHeader>
        <Grid HeightRequest="80" Padding="16" BackgroundColor="{StaticResource Primary}">
            <Label Text="CheckListApp"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center" />
        </Grid>
    </Shell.FlyoutHeader>

    <ShellContent
        Title="Шаблоны действий"
        ContentTemplate="{DataTemplate pages:TemplatesPage}"
        Route="templates" />

    <ShellContent
        Title="Архив действий"
        ContentTemplate="{DataTemplate pages:ArchivePage}"
        Route="archive" />

</Shell>