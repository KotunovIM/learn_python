<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="AndroidApp.Pages.ArchivePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:AndroidApp.Models"
    xmlns:pageModels="clr-namespace:AndroidApp.PageModels"
    x:DataType="pageModels:ArchivePageModel"
    x:Name="RootPage"
    Title="Архив действий">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🗑"
                     Command="{Binding ClearArchiveCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" RowSpacing="15" Padding="15">

        <Label Grid.Row="0"
               Text="Архив действий"
               FontSize="26"
               FontAttributes="Bold"
               SemanticProperties.HeadingLevel="Level1"
               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Archive}"
                        SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ArchivedAction">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                                <SwipeItem Text="Вернуть"
                                           BackgroundColor="{StaticResource Primary}"
                                           Command="{Binding Path=BindingContext.RestoreActionCommand, Source={x:Reference RootPage}, x:DataType=pageModels:ArchivePageModel}"
                                           CommandParameter="{Binding .}" />
                                <SwipeItem Text="Удалить"
                                           BackgroundColor="{StaticResource Magenta}"
                                           Command="{Binding Path=BindingContext.DeleteArchiveCommand, Source={x:Reference RootPage}, x:DataType=pageModels:ArchivePageModel}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                                Padding="12,10">

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <BoxView Grid.Column="0"
                                         WidthRequest="10" HeightRequest="10"
                                         CornerRadius="5"
                                         VerticalOptions="Center"
                                         Color="{Binding AccentColor}" />

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding Text}"
                                           FontSize="14"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Label FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource LightOnDarkBackground}}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="✓ из " />
                                                <Span Text="{Binding ChecklistName}" FontAttributes="Italic" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="{Binding CompletedAtText}"
                                       FontSize="11"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource LightOnDarkBackground}}" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="Архив пуст. Отметьте действия в шаблонах."
                       FontSize="14"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource LightOnDarkBackground}}" />
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>