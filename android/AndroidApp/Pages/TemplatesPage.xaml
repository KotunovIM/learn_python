<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="AndroidApp.Pages.TemplatesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AndroidApp.Controls"
    xmlns:models="clr-namespace:AndroidApp.Models"
    xmlns:pageModels="clr-namespace:AndroidApp.PageModels"
    x:DataType="pageModels:TemplatesPageModel"
    x:Name="RootPage"
    Title="Шаблоны">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+"
                     Command="{Binding AddChecklistCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="15" Padding="15">

        <Label Grid.Row="0"
               Text="Добрый день 👋"
               FontSize="14"
               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource LightOnDarkBackground}}" />

        <Label Grid.Row="1"
               Text="Шаблоны действий"
               FontSize="26"
               FontAttributes="Bold"
               SemanticProperties.HeadingLevel="Level1"
               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

        <!-- ▼▼▼ Горизонтальная лента, прижата к верху ▼▼▼ -->
<CollectionView Grid.Row="2"
                x:Name="ChecklistsCollectionView"
                ItemsSource="{Binding Templates}"
                SelectionMode="Single"
                SelectionChanged="OnChecklistSelected"
                HeightRequest="180"
                VerticalOptions="Start">

    <CollectionView.ItemsLayout>
        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
    </CollectionView.ItemsLayout>

    <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="models:Checklist">
            <SwipeView>
                <SwipeView.BottomItems>
                    <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                        <SwipeItem Text="Изменить"
                                   BackgroundColor="{StaticResource Primary}"
                                   Command="{Binding Path=BindingContext.EditChecklistCommand, Source={x:Reference RootPage}, x:DataType=pageModels:TemplatesPageModel}"
                                   CommandParameter="{Binding .}" />
                        <SwipeItem Text="Удалить"
                                   BackgroundColor="{StaticResource Magenta}"
                                   Command="{Binding Path=BindingContext.DeleteChecklistCommand, Source={x:Reference RootPage}, x:DataType=pageModels:TemplatesPageModel}"
                                   CommandParameter="{Binding .}" />
                    </SwipeItems>
                </SwipeView.BottomItems>

                <controls:ChecklistCardView WidthRequest="160" HeightRequest="160" />
            </SwipeView>
        </DataTemplate>
    </CollectionView.ItemTemplate>

    <CollectionView.EmptyView>
        <Label Text="Нет шаблонов. Нажмите «+» чтобы создать."
               FontSize="14"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0,30,0,0"
               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource LightOnDarkBackground}}" />
    </CollectionView.EmptyView>
	</CollectionView>
</Grid>
</ContentPage>