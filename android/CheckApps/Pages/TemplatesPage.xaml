<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CheckApps.Pages.TemplatesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pageModels="clr-namespace:CheckApps.PageModels"
    xmlns:models="clr-namespace:CheckApps.Models"
    xmlns:controls="clr-namespace:CheckApps.Controls"
	x:DataType="pageModels:TemplatesPageModel"
    Title="ПАМЯТКА ДЕЙСТВИЙ"
    BackgroundColor="#E8EDE3">

    <Grid RowDefinitions="Auto,*" RowSpacing="12" Padding="15">

        <!-- 1. Заголовок -->
        <Label Grid.Row="0"
               Text="ШАБЛОНЫ"
               FontSize="24"
               HorizontalOptions="Center" />

        <!-- 2. Лента шаблонов -->
        <CollectionView Grid.Row="1"
						ItemsSource="{Binding Templates}"
                        x:Name="ChecklistsCollectionView"
                        HeightRequest="180"
                        VerticalOptions="Start">
			
			<CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="models:Checklist">
					<controls:ChecklistCardView WidthRequest="160" HeightRequest="160" />
				</DataTemplate>
                <!--DataTemplate x:DataType="models:Checklist">
                    <Label Text="{Binding Name}"
                       FontSize="18"
                       TextColor="Black"
                       Padding="10"
                       BackgroundColor="LightYellow" />
                </DataTemplate-->
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>