<Shell
    x:Class="CheckApps.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CheckApps.Pages">

    <TabBar>
        <Tab Title="Шаблоны" >
            <ShellContent
                Route="templates"
                ContentTemplate="{DataTemplate pages:TemplatesPage}" />
        </Tab>

        <Tab Title="Архив" >
            <ShellContent
         Route="arhiv"
         ContentTemplate="{DataTemplate pages:ArchivePage}" />
        </Tab>
        <!-- Позже здесь можно добавить новые вкладки -->
    </TabBar>

</Shell>